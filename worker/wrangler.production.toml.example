# Production-only deployment config. Use only after a reviewed staging release.
# Copy to worker/wrangler.production.toml and replace with the production D1 ID.
name = "sr-brm-api"
main = "index.js"
compatibility_date = "2026-11-02"
workers_dev = true

[vars]
APP_ORIGIN = "https://sr-brm-v3.pages.dev"
MAIL_FROM = "SR BRM Team <team@YOUR_VERIFIED_SENDING_DOMAIN>"
BOOTSTRAP_ADMIN_EMAIL = "REPLACE_WITH_OWNER_EMAIL"

[[d1_databases]]
binding = "DB"
database_name = "sr-brm-production"
database_id = "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID"
